# Copiez ce fichier en « inventory.ini » et mettez l'adresse de VOTRE serveur.
# inventory.ini n'est pas envoyé sur GitHub (voir .gitignore).

[staging]
staging1 ansible_host=203.0.113.10

[all:vars]
ansible_user=deploy
# Clé créée au lab 8 (inutile dans le pipeline : l'action fournit la clé)
ansible_ssh_private_key_file=~/.ssh/todo_deploy
